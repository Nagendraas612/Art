# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/atelier?schema=public"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email API
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Atelier & Co. <concierge@yourdomain.com>"

# Cashfree Integration (SANDBOX / PRODUCTION)
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENVIRONMENT=SANDBOX
# Mirror of CASHFREE_ENVIRONMENT for the client-side Cashfree SDK (SANDBOX / PRODUCTION)
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=SANDBOX

# Dev-only: when "true", checkout uses the sandbox simulator instead of Cashfree.
# NEVER set this to true in production. Decided server-side only.
SANDBOX_CHECKOUT_ENABLED=false

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
