# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/atelier?schema=public"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email API
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Atelier & Co. <concierge@yourdomain.com>"

# Razorpay Integration (TEST / LIVE)
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
# Webhook secret from the Razorpay Dashboard (Settings > Webhooks). Used to
# verify the x-razorpay-signature on /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
# Public key for the client-side Razorpay Checkout.js (KEY_ID only — never
# expose the secret to the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key_id_here"

# Shiprocket Integration (Phase 1: live rates, Phase 2: auto-dispatch, Phase 3: tracking webhooks)
# API user credentials (Shiprocket panel → Settings → API → API Users).
# The site falls back to the admin flat fee when these are absent.
SHIPROCKET_API_USER_EMAIL="your_shiprocket_api_user_email"
SHIPROCKET_API_PASSWORD="your_shiprocket_api_user_password"
# Phase 3: shared secret for the tracking webhook receiver
# (/api/webhooks/shiprocket). Must match the Token entered in the Shiprocket
# panel (Settings → API → Webhooks, Auth Token Type: x-api-key).
SHIPROCKET_WEBHOOK_TOKEN="generate_a_random_secret_here"

# Dev-only: when "true", checkout uses the sandbox simulator instead of Razorpay.
# NEVER set this to true in production. Decided server-side only.
SANDBOX_CHECKOUT_ENABLED=false

# Cloudinary (required for image uploads — signed uploads only)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# NOTE: unsigned upload presets are no longer used. Do not create one;
# the server signs every upload request.

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Rate limiting (Upstash Redis). When both are set, limits are shared across
# all serverless instances. When missing, the app falls back to an in-memory
# Map per instance — fine for dev, but on Vercel each lambda gets its own
# counter, so set these in Production.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<redacted>"
